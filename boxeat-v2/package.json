{
  "name": "boxeat-v2",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "api:dev": "pnpm --filter @boxeat/api dev",
    "mobile:dev": "pnpm --filter @boxeat/mobile dev",
    "db:migrate": "pnpm --filter @boxeat/api prisma:migrate",
    "db:seed": "pnpm --filter @boxeat/api prisma:seed",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
